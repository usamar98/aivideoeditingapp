# Public product configuration
# Local app return origin. On Vercel Production use https://www.editingapp.live.
# Public SEO canonicals always resolve to a production origin, never localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: HTML meta-tag CONTENT value only, not the whole tag. DNS verification needs neither.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SUPPORT_EMAIL=support@editingapp.live
# Keep fixture mode explicit. Set false in production.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (publishable values may be exposed; never expose the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI providers (server-side only)
GEMINI_API_KEY=
FAL_KEY=
# Enable only after confirming this fal account has Seedance 2.5 access.
# Set on Vercel; the worker uses the existing FAL_KEY. Kling O3 is the default.
CARTOON_SEEDANCE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Durable jobs and billing (server-side only)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_buramjqzkflsxgozeeew
MEDIA_FETCH_HOSTS=
FFMPEG_PATH=ffmpeg
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# No monthly/yearly price IDs. Preview the six prices with npm run billing:setup.
# Apply the matching catalog as described in docs/DEPLOYMENT.md before accepting payment.
# Enable payment methods, invoices, plan switching, and cancellation in Stripe's portal.

# Limits and prices are configuration, not provider promises.
MAX_EPISODE_SECONDS=60
MAX_SCENES_PER_EPISODE=10
MAX_CONCURRENT_GENERATIONS=2
SCENE_ANIMATION_CREDITS=18
