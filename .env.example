# Public product configuration
NEXT_PUBLIC_PRODUCT_NAME=FrameFoundry
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Keep fixture mode explicit. Set false in production.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (publishable values may be exposed; never expose the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI providers (server-side only)
GEMINI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Durable jobs and billing (server-side only)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
MEDIA_FETCH_HOSTS=
FFMPEG_PATH=ffmpeg
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
# Server-authoritative mapping; never trust a credit quantity from checkout custom data.
PADDLE_CREDIT_PRICE_MAP_JSON={}

# Limits and prices are configuration, not provider promises.
MAX_EPISODE_SECONDS=60
MAX_SCENES_PER_EPISODE=10
MAX_CONCURRENT_GENERATIONS=2
SCENE_ANIMATION_CREDITS=18
